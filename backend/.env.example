# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (see NFR-2.1: no third-party keys in client bundles).

# --- App ---
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-string

# --- Supabase (DB + Auth) ---
# Leave these as replace-me to run locally without a database: saved portfolios
# then go to backend/.local_portfolios.json and chat history stays in memory.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me

# --- Market Data Feed (FR-2.1) ---
FINNHUB_API_KEY=replace-me
# Alternative provider, if used instead of Finnhub:
# POLYGON_API_KEY=replace-me

# --- LLM Explanation Layer (FR-5.2) ---
GROQ_API_KEY=replace-me
# Agent model (needs tool calling) and the faster model for dashboard explanations.
# Run `python check_models.py` to list the models your key can use.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXPLAIN_MODEL=openai/gpt-oss-20b

# --- CORS: frontend origins allowed to call this API (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting / cache (FR-2.4) ---
MARKET_DATA_CACHE_TTL_SECONDS=300
MAX_REQUESTS_PER_MINUTE=60
