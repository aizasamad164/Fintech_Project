# Copy to .env and fill in.
# NFR-2.1: only PUBLIC/anon keys belong here — never Groq/Finnhub/service-role keys.

VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# Stripe TEST publishable key (pk_test_...). Safe to expose; the secret key stays in backend/.env
VITE_STRIPE_PUBLISHABLE_KEY=

# true = run the UI on mock data with no backend
VITE_USE_MOCK=false
